# Copy this file to .env.local and fill in at least one API key.
# The app will automatically use these keys at startup — no manual entry needed.

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# OpenAI GPT (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Gardener Answering Machine (SAP internal — requires VPN)
GARDENER_API_KEY=

# Enable local ML features (plot suggester + prompt suggestions chip bar in chat)
# Requires generating artifacts first: npx tsx core/frontend/scripts/training/trainPromptSuggester.ts
VITE_USE_LOCAL_ML=true
