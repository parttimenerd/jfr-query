    "preview": "vite preview",
    "test": "node scripts/check-template-licenses.mjs && vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:workflows": "node tests/e2e/test-workflows.mjs",
    "test:notebook-workflows": "npx playwright test e2e/notebook-workflows.spec.ts",
    "test:sidebar-features": "npx playwright test e2e/sidebar-features.spec.ts",
    "test:plot-interactions": "npx playwright test e2e/plot-interactions.spec.ts",
    "test:variable-workflows": "npx playwright test e2e/variable-workflows.spec.ts",
