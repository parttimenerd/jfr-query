    "bench:import": "node tests/e2e/benchmark-import.mjs",
    "bench:import:serial": "node tests/e2e/benchmark-import.mjs --serial",
    "bench:import:large": "node tests/e2e/benchmark-import.mjs --large",
    "bench:import:large:serial": "node tests/e2e/benchmark-import.mjs --large --serial",
    "test:e2e:all": "npx playwright test e2e/",
